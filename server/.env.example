# Copy this to .env for local development — never commit the real .env!

# Server port (Render ignores this; it sets PORT automatically)
PORT=5000

# PostgreSQL connection string
# Local:      postgresql://postgres@localhost:5432/redimvidb
# Render:     manually set via Render Dashboard using Internal Database URL
DATABASE_URL=postgresql://postgres@localhost:5432/redimvidb

# JWT secret — use a long random string in production
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Set to "production" on Render, "development" locally
NODE_ENV=development

# Your Vercel frontend URL (set this on Render dashboard)
# Example: https://redimvi.vercel.app
FRONTEND_URL=http://localhost:5173

# Email (SMTP) configuration for verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Redimvi <noreply@redimvi.com>"

